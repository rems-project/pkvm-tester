#!/bin/zsh
set -e

BRANCH=${BRANCH:-'binaries/kernel-6.18'}
SRC="https://github.com/rigorous-engineering/pkvm-proxy-ocaml/raw/refs/heads/$BRANCH/tests.tar.zst"

EXE_PATH=${0:A:h}/../ramfs.exe
EXE_PATH=${EXE_PATH:a}

die() { echo $@ >&2; exit 1; }
type "curl" > /dev/null || die "ERROR: please install 'curl'."
tests=( $EXE_PATH/test_*(N) )
(( $#tests > 0 )) && die "ERROR: refusing to overwrite tests in $EXE_PATH"

curl -sL "$SRC"|tar xvf - --zstd -C $EXE_PATH
