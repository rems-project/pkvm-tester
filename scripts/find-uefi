#!/bin/zsh

# priority order
qemus=(
  "${^=NIX_PROFILES:-/INVALID}/share/qemu"
  '/usr/local/share/qemu'
  '/opt/homebrew/Cellar/qemu'
  '/usr/share/qemu'
)

files=( ${^qemus}/**/firmware/*.json(N) )
(( $#files )) || { echo "Cannot find Qemu firmware definitions."; exit 1; }

query='
  [ .[]|
    select(.targets[].architecture == "aarch64") |
    select(.mapping.device == "flash") |
    select(.mapping.executable.format == "raw") |
    select(.features|all(. != "secure-boot")) ] |
  (. + [ .[] | select(.features|all(startswith("verbose")|not)) ]).[0] |
  .mapping.executable.filename
'

jq -sr $query $files
